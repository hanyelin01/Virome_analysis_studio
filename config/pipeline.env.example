# Copy this file to config/pipeline.env on the Linux server and adjust it.
ALLOWED_DATA_ROOTS=/srv/contig_projects:/home/hanyl/Projects
MAX_TOTAL_THREADS=96
MAX_QC_PARALLEL=8
MAX_ASSEMBLY_PARALLEL=4
MAX_THREADS_PER_MEGHIT=48
MAX_THREADS_PER_FASTP=32
# Versioned adapter catalogue. Keep the server-local config pointed at the
# catalogue shipped with this release unless you maintain a reviewed override.
ADAPTER_CATALOG=$PIPELINE_HOME/config/adapter_catalog.tsv
ADAPTER_SEQUENCE_REFERENCE=$PIPELINE_HOME/config/adapter_sequence_reference.tsv
FASTP_DEFAULT_ADAPTER_PROFILE=auto
# Number of raw reads per mate sampled for exact reference-sequence evidence.
ADAPTER_REFERENCE_SCAN_READS=100000
FASTP_QUALIFIED_QUALITY_PHRED=6
FASTP_UNQUALIFIED_PERCENT_LIMIT=50
FASTP_N_BASE_LIMIT=15
FASTP_LENGTH_REQUIRED=50

# Viral diversity-report module.  Leave database paths blank until the tools
# and their reference databases have been installed on the Linux server.
GENOMAD_DB=
CHECKV_DB=
MAX_THREADS_PER_VIRAL_TOOL=32
VIRAL_MIN_CONTIG_LEN=1000
# Samples are analysed independently after CheckV. Vclust is used only to
# remove redundant candidates within a sample; it is not a cross-sample study.
VOTU_POST_CHECKV_MIN_LEN=1000
VOTU_ANI=95
VOTU_ALIGNED_FRACTION=85
COVERM_MIN_READ_PERCENT_IDENTITY=95
COVERM_MIN_READ_ALIGNED_PERCENT=75
COVERM_MIN_COVERED_FRACTION=10
VOTU_IMPORTANCE_RELATIVE_ABUNDANCE=5
BATCH_OVERVIEW_RANK=family

# Offline report dashboard.  The dashboard is an evidence-aware navigator:
# it does not run a cross-sample diversity analysis or compare abundance among
# samples.  REPORT_TOP_TAXA limits only the size of the batch matrix/chart.
REPORT_THEME=quarto-scientific
# Use 0 to display all classified taxa in the batch chart and matrix.
REPORT_TOP_TAXA=0
# These are user-configurable "families requiring priority review".  This is
# a navigation label based on sequence annotation only; it is not a risk,
# infectivity or zoonosis conclusion.
REPORT_PRIORITY_FAMILIES=Coronaviridae,Paramyxoviridae,Orthomyxoviridae,Flaviviridae
# Versioned ICTV MSL reference and the concise navigation-only attention list.
# These files are shipped with the package and can be replaced by local copies.
ICTV_FAMILY_GENOME_REFERENCE=$PIPELINE_HOME/config/ictv_family_genome_reference.tsv
PRIORITY_REVIEW_TAXA_REFERENCE=$PIPELINE_HOME/config/priority_review_taxa.tsv

# Optional fine-annotation module. DIAMOND_NR_DB is a complete NR protein
# database, not a virus-only database. The default virus-only search is
# achieved at runtime with --taxonlist 10239.
DIAMOND_NR_DB=
DIAMOND_DEFAULT_TAXONLIST=10239
DIAMOND_EVALUE=1e-5
DIAMOND_NR_MAX_TARGET_SEQS=25
DIAMOND_SENSITIVITY=more-sensitive

# MEGAN is optional and is required only when generating RMA6 files.
# MEGAN_DAA2RMA should be the absolute executable path when it is not in PATH.
MEGAN_DAA2RMA=
MEGAN_MAP_DB=

# Directory containing names.dmp, nodes.dmp, merged.dmp and delnodes.dmp.
TAXONKIT_DB=

# Optional VirSorter2 integration. Leave the defaults when VirSorter2 lives
# in contig-ui and was installed with its normal internal environments.
# For an isolated VirSorter2 environment, set VIRSORTER_COMMAND to its absolute
# executable path and VIRSORTER_USE_CONDA_OFF=1.
VIRSORTER_COMMAND=virsorter
VIRSORTER_USE_CONDA_OFF=0
